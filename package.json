{
  "name": "cocopit",
  "version": "0.3.0",
  "description": "A local-first web console for Claude Code — usage & cost analytics, session browsing, multi-account management, config editing, and a built-in web terminal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gps949/cocopit.git"
  },
  "homepage": "https://github.com/gps949/cocopit#readme",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "dashboard",
    "console",
    "usage",
    "terminal",
    "bun"
  ],
  "bin": {
    "cocopit": "bin/cocopit.ts"
  },
  "files": [
    "bin",
    "server",
    "!server/test",
    "shared",
    "web/dist",
    "docs/logo.png",
    "docs/manual.md",
    "docs/manual.zh-CN.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd web build",
    "start": "bun server/index.ts",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "bun-types": "^1.3.14"
  }
}
